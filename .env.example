# Firebase Configuration
# Replace these with your Firebase Web App credentials from Firebase Console -> Project Settings -> General -> Your apps -> SDK setup and configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Live site address used inside every table QR code (no trailing slash).
# QR codes are printed once, so this MUST be the real public URL, not localhost.
VITE_PUBLIC_SITE_URL=https://your-live-site.netlify.app

# Cloudinary (menu photos). SERVER-ONLY: used by netlify/functions/cloudinary-sign.mjs.
# No VITE_ prefix on purpose, so Vite never puts these in the browser bundle.
# Uploads are forced into the junio8/menu folder and only Junio 8 admins can upload.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase service account (SERVER-ONLY, used by netlify/functions/staff-admin.mjs
# so the admin can create staff logins, change passwords and block accounts).
# Firebase Console → Project settings → Service accounts → Generate new private key,
# then copy "client_email" and "private_key" from the downloaded JSON.
# Keep the quotes and the \n in the key. Never commit the real values.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional Restaurant Branding
VITE_RESTAURANT_CURRENCY="₹"
VITE_RESTAURANT_TAX_PERCENT=5
